# ================================================================
# BRJobs Backend (Spring Boot) - TEMPLATE de variaveis de ambiente
# ----------------------------------------------------------------
# Copie este arquivo para:
#   brjobs-java/.env.dev    -> desenvolvimento local (docker-compose.yml da raiz)
#   brjobs-java/.env.prod   -> producao / EC2 (docker-compose.prod.yml)
# NUNCA comite .env, .env.dev ou .env.prod - apenas este .env.example.
# Todas as chaves tem default em application.properties; abaixo estao
# as que normalmente voce sobrescreve por ambiente.
# ================================================================

SERVER_PORT=8080

# --- Deploy (apenas .env.prod / EC2) ------------------------------
# Usadas pela substituicao de imagem do docker-compose.prod.yml
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1
ECR_REPOSITORY=brjobs-api
IMAGE_TAG=latest

# --- Banco de dados (PostgreSQL) ----------------------------------
POSTGRES_DB=brjobsdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=brjobsdb
DB_USER=postgres
DB_PASSWORD=
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/brjobsdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# --- JWT ----------------------------------------------------------
# Gere um segredo forte: openssl rand -base64 64
BRJOBS_JWT_SECRET=
BRJOBS_JWT_EXPIRATION=3600000

# --- OAuth Google -------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# dev: http://localhost:8080/...  | prod: https://api.brjobs.com.br/...
OAUTH2_REDIRECT_URI=http://localhost:8080/login/oauth2/code

# --- Frontend / cookies -------------------------------------------
# dev: http://localhost:4200 + secure=false | prod: https://brjobs.com.br + secure=true
FRONTEND_BASE_URL=http://localhost:4200
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# --- Reset de senha -----------------------------------------------
PASSWORD_RESET_EXPIRES_MINUTES=15
# dev: true (retorna o codigo na resposta p/ testar) | prod: false
PASSWORD_RESET_EXPOSE_CODE=false

# --- E-mail (Resend) ----------------------------------------------
RESEND_API_KEY=
RESEND_FROM=BRJobs <onboarding@resend.dev>

# --- Stripe / destaque de publicacao ------------------------------
# Backend usa STRIPE_SECRET_KEY (sk_...) e HIGHLIGHT_WEBHOOK_SECRET (whsec_...).
# A chave publicavel (pk_) fica no FRONTEND (environment.ts), nao aqui.
# dev: sk_test_ + `stripe listen` para o whsec | prod: sk_live_ + webhook do Dashboard
STRIPE_SECRET_KEY=
HIGHLIGHT_WEBHOOK_SECRET=
HIGHLIGHT_DEFAULT_CURRENCY=brl
HIGHLIGHT_CHECKOUT_SUCCESS_URL=http://localhost:4200/minhas-publicacoes?highlight=success
HIGHLIGHT_CHECKOUT_CANCEL_URL=http://localhost:4200/minhas-publicacoes?highlight=cancel
HIGHLIGHT_EXPIRATION_CRON=0 */1 * * * *

# --- Redis (opcional; default desligado) --------------------------
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
